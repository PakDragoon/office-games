rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then click Publish.
//
// Anyone signed in (the game signs in anonymously) can read crews and add rounds.
// Nobody can edit or delete a saved round, and a crew's round count can only go up by one.
service cloud.firestore {
  match /databases/{database}/documents {

    match /crews/{crewId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && crewId.matches('^[a-z0-9-]{3,40}$')
        && validCrew()
        && request.resource.data.rounds == 1;

      allow update: if request.auth != null
        && validCrew()
        && request.resource.data.rounds == resource.data.rounds + 1;

      allow delete: if false;

      match /rounds/{roundId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['word', 'winRule', 'winner', 'room', 'players', 'at'])
          && request.resource.data.word is string
          && request.resource.data.word.size() == 5
          && request.resource.data.players is list
          && request.resource.data.players.size() >= 1
          && request.resource.data.players.size() <= 5;

        allow update, delete: if false;
      }
    }

    function validCrew() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'rounds', 'players', 'history', 'updatedAt'])
        && d.name is string && d.name.size() <= 40
        && d.rounds is int
        && d.players is map
        && d.history is list && d.history.size() <= 20;
    }
  }
}
