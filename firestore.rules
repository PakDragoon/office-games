rules_version = '2';
// Paste this into Firebase console > Firestore Database > Rules, then click Publish.
//
// This one file covers BOTH games in the wordle-party-81870 project. Firestore only has
// one set of rules per database, so publishing a Thulla-only file would break Wordle Party.
// The Wordle Party section below is unchanged from the Wordle repo.
//
// Only players signed in with Google can read or save anything.
// Wordle Party: crews, users. Thulla: thullaCrews, thullaUsers.
// - Crews: any signed-in player can add a round; saved rounds can't be edited or deleted,
//   and a crew's round count can only go up by one.
// - Profiles: each player can only write their own profile.

service cloud.firestore {
  match /databases/{database}/documents {

    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // ===================== Wordle Party (unchanged) =====================

    match /crews/{crewId} {
      allow read: if isGoogleUser();
      allow create: if isGoogleUser()
        && crewId.matches('^[a-z0-9-]{3,40}$')
        && validCrew()
        && request.resource.data.rounds == 1;
      allow update: if isGoogleUser()
        && validCrew()
        && request.resource.data.rounds == resource.data.rounds + 1;
      allow delete: if false;

      match /rounds/{roundId} {
        allow read: if isGoogleUser();
        allow create: if isGoogleUser()
          && request.resource.data.keys().hasOnly(['word', 'winRule', 'hard', 'winner', 'room', 'players', 'at'])
          && request.resource.data.word is string
          && request.resource.data.word.size() == 5
          && request.resource.data.players is list
          && request.resource.data.players.size() >= 1
          && request.resource.data.players.size() <= 5;
        allow update, delete: if false;
      }
    }

    match /users/{uid} {
      allow read: if isGoogleUser();
      allow create: if isGoogleUser()
        && request.auth.uid == uid
        && validUser()
        && request.resource.data.games == 1;
      allow update: if isGoogleUser()
        && request.auth.uid == uid
        && validUser()
        && request.resource.data.games == resource.data.games + 1;
      allow delete: if false;

      match /games/{gameId} {
        allow read: if isGoogleUser() && request.auth.uid == uid;
        allow create: if isGoogleUser()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['word', 'room', 'solved', 'guesses', 'ms', 'won', 'opener', 'at'])
          && request.resource.data.word is string
          && request.resource.data.word.size() == 5
          && request.resource.data.guesses is int
          && request.resource.data.guesses >= 0
          && request.resource.data.guesses <= 6;
        allow update, delete: if false;
      }
    }

    function validCrew() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'rounds', 'players', 'history', 'updatedAt'])
        && d.name is string && d.name.size() <= 40
        && d.rounds is int
        && d.players is map
        && d.history is list && d.history.size() <= 20;
    }

    function validUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'photo', 'games', 'wins', 'solved', 'guessSum', 'bestMs',
                               'streak', 'bestStreak', 'dist', 'openers', 'updatedAt'])
        && d.games is int
        && d.dist is list && d.dist.size() == 6
        && d.openers is map;
    }

    // ============================== Thulla ==============================

    match /thullaCrews/{crewId} {
      allow read: if isGoogleUser();
      allow create: if isGoogleUser()
        && crewId.matches('^[a-z0-9-]{3,40}$')
        && validThullaCrew()
        && request.resource.data.rounds == 1;
      allow update: if isGoogleUser()
        && validThullaCrew()
        && request.resource.data.rounds == resource.data.rounds + 1;
      allow delete: if false;

      match /rounds/{roundId} {
        allow read: if isGoogleUser();
        allow create: if isGoogleUser()
          && request.resource.data.keys().hasOnly(['room', 'loser', 'players', 'at'])
          && request.resource.data.room is string
          && request.resource.data.loser is string
          && request.resource.data.players is list
          && request.resource.data.players.size() >= 2
          && request.resource.data.players.size() <= 8;
        allow update, delete: if false;
      }
    }

    match /thullaUsers/{uid} {
      allow read: if isGoogleUser();
      allow create: if isGoogleUser()
        && request.auth.uid == uid
        && validThullaUser()
        && request.resource.data.rounds == 1;
      allow update: if isGoogleUser()
        && request.auth.uid == uid
        && validThullaUser()
        && request.resource.data.rounds == resource.data.rounds + 1;
      allow delete: if false;
    }

    function validThullaCrew() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'rounds', 'players', 'history', 'updatedAt'])
        && d.name is string && d.name.size() <= 40
        && d.rounds is int
        && d.players is map
        && d.history is list && d.history.size() <= 20;
    }

    function validThullaUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'photo', 'rounds', 'losses', 'posSum', 'playersSum',
                               'given', 'received', 'updatedAt'])
        && d.rounds is int
        && d.losses is int && d.losses >= 0 && d.losses <= d.rounds
        && d.posSum is int && d.given is int && d.received is int;
    }
  }
}
